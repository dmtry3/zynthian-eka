        <http://dmtry3.github.io/zynthian-eka/fold#m_vel_pitch> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_harmonics> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_color> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_morph> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_index> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_order> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_symmetry> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_timbre> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_lpg> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_dtime> , <http://dmtry3.github.io/zynthian-eka/fold#m_vel_dfb> ,
        <http://dmtry3.github.io/zynthian-eka/fold#m_key_pitch> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_harmonics> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_color> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_morph> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_index> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_order> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_symmetry> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_timbre> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_lpg> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_dtime> , <http://dmtry3.github.io/zynthian-eka/fold#m_key_dfb> ,
        <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_pitch> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_harmonics> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_color> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_morph> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_index> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_order> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_symmetry> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_timbre> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_lpg> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_dtime> , <http://dmtry3.github.io/zynthian-eka/fold#m_wheel_dfb> ,
        <http://dmtry3.github.io/zynthian-eka/fold#m_at_pitch> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_harmonics> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_color> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_morph> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_index> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_order> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_symmetry> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_timbre> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_lpg> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_dtime> , <http://dmtry3.github.io/zynthian-eka/fold#m_at_dfb> ;
    # Control input ports MUST be indices 0..N-1 (before atom and audio ports): Zynthian numbers LV2 parameters
    # from len(control ports)+1 and would overwrite a control port with a higher index.
    # Source: Sine or one of the engines VA, FM2, Wave; Harmonics, Color, Morph: their knobs (TZ 4.1; Color is
    # what the engines call Timbre: Timbre here is the shaper depth).
    # Outputs for the widget: note1..4 = MIDI note of each sounding voice, -1 = idle; out_peak = output peak, dB;
    # mod_phase = Mod OSC phase 0..1 of the newest voice, -1 = none; gate_level = its vactrol state 0..1;
    # fg1, fg2 = where its function generators are: 0..1 rising, 1.5 holding, 2..3 falling, 3 ended;
    # delay_level = the peak in its delay line (0 with the delay Off).
    # Delay: Off / Tuned / Free; Time 0..100 read by the mode (Tuned: -24..+24 semitones from the note; Free:
    # 2 s x (Time / 100)^3, at least 1 ms); Feedback -100..100 %; Mix: how much of the line the voice hears.
    # Mod Freq: 0..100, read by Mod Mode (Free: 0.01 Hz..10 kHz, logarithmic; Keytrack: -48..+48 semitones;
    # Ratio: 25 ratios 1/8..16); the widget shows what it means.
    # Timbre: depth of the shapers (0 = the Principal passes); Order: Folder (0) .. Saw (50) .. M (100);
    # Symmetry: offset before the shapers; Drive: soft saturation after them.
    # Gate Mode: VCA / LP / Combo; Decay: how slowly the vactrol closes, 10 ms..2 s; FG Rise / Fall: 1 ms..10 s.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "source" ; lv2:name "Source" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Sine" ; rdf:value 0 ] , [ rdfs:label "VA" ; rdf:value 1 ] , [ rdfs:label "FM2" ; rdf:value 2 ] , [ rdfs:label "Wave" ; rdf:value 3 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "harmonics" ; lv2:name "Harmonics %" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "color" ; lv2:name "Color %" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "morph" ; lv2:name "Morph %" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "mod_freq" ; lv2:name "Mod Freq" ;
        lv2:default 30 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "mod_index" ; lv2:name "Mod Index %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
