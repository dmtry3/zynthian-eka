@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Knob pages, in this order (higher displayPriority first). Osc, Mod, Timbre and a temporary Env (plain ADSR,
# replaced by FG1 and the lopass gate at stage 3). Later stages add Gate, Delay.
<http://dmtry3.github.io/zynthian-eka/fold#g_osc> a pg:Group ; lv2:symbol "g_osc" ; lv2:name "Osc" ; lv2:index 0 ; lv2:displayPriority 60 .
<http://dmtry3.github.io/zynthian-eka/fold#g_mod> a pg:Group ; lv2:symbol "g_mod" ; lv2:name "Mod" ; lv2:index 1 ; lv2:displayPriority 55 .
<http://dmtry3.github.io/zynthian-eka/fold#g_timbre> a pg:Group ; lv2:symbol "g_timbre" ; lv2:name "Timbre" ; lv2:index 2 ; lv2:displayPriority 52 .
<http://dmtry3.github.io/zynthian-eka/fold#g_env> a pg:Group ; lv2:symbol "g_env" ; lv2:name "Env" ; lv2:index 3 ; lv2:displayPriority 50 .

# Routing of the Mod OSC into the Principal: set in the widget (Mod tab), saved in the snapshot and in LV2 State.
# notOnGUI: not on a knob page.
<http://dmtry3.github.io/zynthian-eka/fold#route_fm>
    a lv2:Parameter ;
    lv2:symbol "route_fm" ;
    rdfs:label "Route FM" ;
    rdfs:range atom:Int ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_am>
    a lv2:Parameter ;
    lv2:symbol "route_am" ;
    rdfs:label "Route AM" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_sync>
    a lv2:Parameter ;
    lv2:symbol "route_sync" ;
    rdfs:label "Route Sync" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_timbre>
    a lv2:Parameter ;
    lv2:symbol "route_timbre" ;
    rdfs:label "Route Timbre" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .


<http://dmtry3.github.io/zynthian-eka/fold>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Eka Fold" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface ;
    patch:writable <http://dmtry3.github.io/zynthian-eka/fold#route_fm> , <http://dmtry3.github.io/zynthian-eka/fold#route_am> , <http://dmtry3.github.io/zynthian-eka/fold#route_sync> , <http://dmtry3.github.io/zynthian-eka/fold#route_timbre> ;
    # Control input ports MUST be indices 0..N-1 (before atom and audio ports): Zynthian numbers LV2 parameters
    # from len(control ports)+1 and would overwrite a control port with a higher index.
    # Outputs for the widget: note1..4 = MIDI note of each sounding voice, -1 = idle; out_peak = output peak, dB;
    # mod_phase = Mod OSC phase 0..1 of the newest voice, -1 = none.
    # Mod Freq: 0..100, read by Mod Mode (Free: 0.01 Hz..10 kHz, logarithmic; Keytrack: -48..+48 semitones;
    # Ratio: 25 ratios 1/8..16); the widget shows what it means.
    # Timbre: depth of the shapers (0 = the Principal passes); Order: Folder (0) .. Saw (50) .. M (100);
    # Symmetry: offset before the shapers; Drive: soft saturation after them.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "pitch" ; lv2:name "Pitch" ;
        lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "fine" ; lv2:name "Fine cents" ;
        lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_osc> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "attack" ; lv2:name "Attack ms" ;
        lv2:default 5 ; lv2:minimum 1 ; lv2:maximum 10000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_env> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "decay" ; lv2:name "Decay ms" ;
        lv2:default 300 ; lv2:minimum 5 ; lv2:maximum 20000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_env> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "sustain" ; lv2:name "Sustain %" ;
        lv2:default 70 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_env> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "release" ; lv2:name "Release ms" ;
        lv2:default 400 ; lv2:minimum 5 ; lv2:maximum 20000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_env> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "mod_freq" ; lv2:name "Mod Freq" ;
        lv2:default 30 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "mod_index" ; lv2:name "Mod Index %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "mod_shape" ; lv2:name "Mod Shape" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Triangle" ; rdf:value 0 ] , [ rdfs:label "Sine" ; rdf:value 1 ] , [ rdfs:label "Saw" ; rdf:value 2 ] , [ rdfs:label "Square" ; rdf:value 3 ] ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "mod_mode" ; lv2:name "Mod Mode" ;
        lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Free" ; rdf:value 0 ] , [ rdfs:label "Keytrack" ; rdf:value 1 ] , [ rdfs:label "Ratio" ; rdf:value 2 ] ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_mod> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "timbre" ; lv2:name "Timbre %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_timbre> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "order" ; lv2:name "Order" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_timbre> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "symmetry" ; lv2:name "Symmetry" ;
        lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_timbre> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "drive" ; lv2:name "Drive %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/fold#g_timbre> ;
    ] ,
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 14 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 15 ; lv2:symbol "out_l" ; lv2:name "Out L" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 16 ; lv2:symbol "out_r" ; lv2:name "Out R" ;
    ] ,
    [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 17 ; lv2:symbol "notify" ; lv2:name "Notify" ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "note1" ; lv2:name "Note 1" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 127 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "note2" ; lv2:name "Note 2" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 127 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "note3" ; lv2:name "Note 3" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 127 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 21 ; lv2:symbol "note4" ; lv2:name "Note 4" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 127 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 22 ; lv2:symbol "out_peak" ; lv2:name "Output peak dB" ;
        lv2:default -100 ; lv2:minimum -100 ; lv2:maximum 12 ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 23 ; lv2:symbol "mod_phase" ; lv2:name "Mod phase" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] .
