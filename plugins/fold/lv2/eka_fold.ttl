@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Knob pages, in this order (higher displayPriority first). Stage 4: Osc (Source and the engine knobs), Mod,
# Timbre, Gate, Env (function generators), Delay.
<http://dmtry3.github.io/zynthian-eka/fold#g_osc> a pg:Group ; lv2:symbol "g_osc" ; lv2:name "Osc" ; lv2:index 0 ; lv2:displayPriority 60 .
<http://dmtry3.github.io/zynthian-eka/fold#g_mod> a pg:Group ; lv2:symbol "g_mod" ; lv2:name "Mod" ; lv2:index 1 ; lv2:displayPriority 55 .
<http://dmtry3.github.io/zynthian-eka/fold#g_timbre> a pg:Group ; lv2:symbol "g_timbre" ; lv2:name "Timbre" ; lv2:index 2 ; lv2:displayPriority 52 .
<http://dmtry3.github.io/zynthian-eka/fold#g_gate> a pg:Group ; lv2:symbol "g_gate" ; lv2:name "Gate" ; lv2:index 3 ; lv2:displayPriority 51 .
<http://dmtry3.github.io/zynthian-eka/fold#g_env> a pg:Group ; lv2:symbol "g_env" ; lv2:name "Env" ; lv2:index 4 ; lv2:displayPriority 50 .
<http://dmtry3.github.io/zynthian-eka/fold#g_delay> a pg:Group ; lv2:symbol "g_delay" ; lv2:name "Delay" ; lv2:index 5 ; lv2:displayPriority 48 .

# Routing of the Mod OSC into the Principal: set in the widget (Mod tab), saved in the snapshot and in LV2 State.
# notOnGUI: not on a knob page.
<http://dmtry3.github.io/zynthian-eka/fold#route_fm>
    a lv2:Parameter ;
    lv2:symbol "route_fm" ;
    rdfs:label "Route FM" ;
    rdfs:range atom:Int ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_am>
    a lv2:Parameter ;
    lv2:symbol "route_am" ;
    rdfs:label "Route AM" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_sync>
    a lv2:Parameter ;
    lv2:symbol "route_sync" ;
    rdfs:label "Route Sync" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#route_timbre>
    a lv2:Parameter ;
    lv2:symbol "route_timbre" ;
    rdfs:label "Route Timbre" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

# Pitch (semitones) and Fine (cents): set in the widget (Osc tab), saved in the snapshot and in LV2 State.
<http://dmtry3.github.io/zynthian-eka/fold#pitch>
    a lv2:Parameter ;
    lv2:symbol "pitch" ;
    rdfs:label "Pitch" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#fine>
    a lv2:Parameter ;
    lv2:symbol "fine" ;
    rdfs:label "Fine" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

# Function generator modes: set in the widget (Env tab).
<http://dmtry3.github.io/zynthian-eka/fold#fg1_mode>
    a lv2:Parameter ;
    lv2:symbol "fg1_mode" ;
    rdfs:label "FG1 mode" ;
    rdfs:range atom:Int ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
    lv2:scalePoint [ rdfs:label "Once" ; rdf:value 0 ] , [ rdfs:label "Gate" ; rdf:value 1 ] , [ rdfs:label "Cycle" ; rdf:value 2 ] ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#fg2_mode>
    a lv2:Parameter ;
    lv2:symbol "fg2_mode" ;
    rdfs:label "FG2 mode" ;
    rdfs:range atom:Int ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
    lv2:scalePoint [ rdfs:label "Once" ; rdf:value 0 ] , [ rdfs:label "Gate" ; rdf:value 1 ] , [ rdfs:label "Cycle" ; rdf:value 2 ] ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

# The delay's Shaper (0..100 %), EQ Freq (0..100 % = 100 Hz..10 kHz, logarithmic) and EQ Gain (-180..180 = -18.0..
# +18.0 dB, in tenths: in Tuned the EQ acts on every pass, a few tenths matter): set in the widget (Delay tab).
<http://dmtry3.github.io/zynthian-eka/fold#delay_shaper>
    a lv2:Parameter ;
    lv2:symbol "delay_shaper" ;
    rdfs:label "Delay shaper" ;
    rdfs:range atom:Int ;
    lv2:default 30 ; lv2:minimum 0 ; lv2:maximum 100 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#delay_eq_freq>
    a lv2:Parameter ;
    lv2:symbol "delay_eq_freq" ;
    rdfs:label "Delay EQ freq" ;
    rdfs:range atom:Int ;
    lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/fold#delay_eq_gain>
    a lv2:Parameter ;
    lv2:symbol "delay_eq_gain" ;
    rdfs:label "Delay EQ gain" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum -180 ; lv2:maximum 180 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

# Mod matrix (TZ 4.5): m_<source>_<destination>, -100..100 %, set in the widget (Matrix tab; m_fg2_timbre also on
# the Env tab). Sources: FG1, FG2, Mod OSC, Random, Velocity, Key, Mod wheel, Aftertouch; destinations: Pitch
# (100 % = 12 semitones), Harmonics, Color, Morph, Mod Index, Order, Symmetry, Timbre, LPG, Delay Time,
# Delay Feedback (src/fold_core.h).

