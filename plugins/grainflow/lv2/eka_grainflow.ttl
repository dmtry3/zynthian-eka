        lv2:index 3 ; lv2:symbol "freeze" ; lv2:name "Freeze" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/grainflow#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "offset" ; lv2:name "Offset ms" ;
        lv2:default 100 ; lv2:minimum 1 ; lv2:maximum 8000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/grainflow#g_grain> ;
    ] ,
    [
