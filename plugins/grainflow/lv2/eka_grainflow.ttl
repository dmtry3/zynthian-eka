<http://dmtry3.github.io/zynthian-eka/grainflow>
    a lv2:Plugin , lv2:DelayPlugin ;
    doap:name "Eka Grain Flow" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface ;
    patch:writable
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_offset> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_rate> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_length> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_pitch> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_reverse> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_filter> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_spray> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_level> ,
        <http://dmtry3.github.io/zynthian-eka/grainflow#s1_on> ,
