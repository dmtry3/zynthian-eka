    # Control input ports MUST be indices 0..N-1: Zynthian numbers LV2 parameters from len(control ports)+1.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "stream" ; lv2:name "Stream" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] , [ rdfs:label "2" ; rdf:value 2 ] , [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/grainflow#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "mix" ; lv2:name "Mix %" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/grainflow#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "feedback" ; lv2:name "Feedback %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 95 ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/grainflow#g_main> ;
    ] ,
