@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .

<http://dmtry3.github.io/zynthian-eka/bloom#g_play> a pg:Group ; lv2:symbol "g_play" ; lv2:name "Play" ; lv2:index 0 ; lv2:displayPriority 70 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_arp> a pg:Group ; lv2:symbol "g_arp" ; lv2:name "Arp" ; lv2:index 1 ; lv2:displayPriority 60 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_pattern> a pg:Group ; lv2:symbol "g_pattern" ; lv2:name "Pattern" ; lv2:index 2 ; lv2:displayPriority 50 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_groove> a pg:Group ; lv2:symbol "g_groove" ; lv2:name "Groove" ; lv2:index 6 ; lv2:displayPriority 10 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> a pg:Group ; lv2:symbol "g_lengths" ; lv2:name "Lengths" ; lv2:index 3 ; lv2:displayPriority 40 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_scale> a pg:Group ; lv2:symbol "g_scale" ; lv2:name "Scale" ; lv2:index 4 ; lv2:displayPriority 30 .
<http://dmtry3.github.io/zynthian-eka/bloom#g_mutate> a pg:Group ; lv2:symbol "g_mutate" ; lv2:name "Mutate" ; lv2:index 5 ; lv2:displayPriority 20 .

<http://dmtry3.github.io/zynthian-eka/bloom>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "Eka Bloom" ;
    lv2:minorVersion 22 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:extensionData state:interface ;   # pattern steps go into presets
    patch:writable
        <http://dmtry3.github.io/zynthian-eka/bloom#prob1> , <http://dmtry3.github.io/zynthian-eka/bloom#shift1> , <http://dmtry3.github.io/zynthian-eka/bloom#vel1> , <http://dmtry3.github.io/zynthian-eka/bloom#gate1> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch1> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob2> , <http://dmtry3.github.io/zynthian-eka/bloom#shift2> , <http://dmtry3.github.io/zynthian-eka/bloom#vel2> , <http://dmtry3.github.io/zynthian-eka/bloom#gate2> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch2> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob3> , <http://dmtry3.github.io/zynthian-eka/bloom#shift3> , <http://dmtry3.github.io/zynthian-eka/bloom#vel3> , <http://dmtry3.github.io/zynthian-eka/bloom#gate3> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch3> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob4> , <http://dmtry3.github.io/zynthian-eka/bloom#shift4> , <http://dmtry3.github.io/zynthian-eka/bloom#vel4> , <http://dmtry3.github.io/zynthian-eka/bloom#gate4> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch4> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob5> , <http://dmtry3.github.io/zynthian-eka/bloom#shift5> , <http://dmtry3.github.io/zynthian-eka/bloom#vel5> , <http://dmtry3.github.io/zynthian-eka/bloom#gate5> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch5> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob6> , <http://dmtry3.github.io/zynthian-eka/bloom#shift6> , <http://dmtry3.github.io/zynthian-eka/bloom#vel6> , <http://dmtry3.github.io/zynthian-eka/bloom#gate6> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch6> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob7> , <http://dmtry3.github.io/zynthian-eka/bloom#shift7> , <http://dmtry3.github.io/zynthian-eka/bloom#vel7> , <http://dmtry3.github.io/zynthian-eka/bloom#gate7> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch7> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob8> , <http://dmtry3.github.io/zynthian-eka/bloom#shift8> , <http://dmtry3.github.io/zynthian-eka/bloom#vel8> , <http://dmtry3.github.io/zynthian-eka/bloom#gate8> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch8> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob9> , <http://dmtry3.github.io/zynthian-eka/bloom#shift9> , <http://dmtry3.github.io/zynthian-eka/bloom#vel9> , <http://dmtry3.github.io/zynthian-eka/bloom#gate9> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch9> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob10> , <http://dmtry3.github.io/zynthian-eka/bloom#shift10> , <http://dmtry3.github.io/zynthian-eka/bloom#vel10> , <http://dmtry3.github.io/zynthian-eka/bloom#gate10> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch10> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob11> , <http://dmtry3.github.io/zynthian-eka/bloom#shift11> , <http://dmtry3.github.io/zynthian-eka/bloom#vel11> , <http://dmtry3.github.io/zynthian-eka/bloom#gate11> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch11> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob12> , <http://dmtry3.github.io/zynthian-eka/bloom#shift12> , <http://dmtry3.github.io/zynthian-eka/bloom#vel12> , <http://dmtry3.github.io/zynthian-eka/bloom#gate12> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch12> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob13> , <http://dmtry3.github.io/zynthian-eka/bloom#shift13> , <http://dmtry3.github.io/zynthian-eka/bloom#vel13> , <http://dmtry3.github.io/zynthian-eka/bloom#gate13> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch13> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob14> , <http://dmtry3.github.io/zynthian-eka/bloom#shift14> , <http://dmtry3.github.io/zynthian-eka/bloom#vel14> , <http://dmtry3.github.io/zynthian-eka/bloom#gate14> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch14> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob15> , <http://dmtry3.github.io/zynthian-eka/bloom#shift15> , <http://dmtry3.github.io/zynthian-eka/bloom#vel15> , <http://dmtry3.github.io/zynthian-eka/bloom#gate15> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch15> ,
        <http://dmtry3.github.io/zynthian-eka/bloom#prob16> , <http://dmtry3.github.io/zynthian-eka/bloom#shift16> , <http://dmtry3.github.io/zynthian-eka/bloom#vel16> , <http://dmtry3.github.io/zynthian-eka/bloom#gate16> , <http://dmtry3.github.io/zynthian-eka/bloom#ratch16> ;
    # Control input ports MUST be indices 0..N-1 (before atom ports): Zynthian numbers LV2 parameters
    # from len(control ports)+1 and would overwrite a control port with a higher index.
    lv2:port
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 30 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , patch:Message ;
        lv2:index 31 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "rate" ; lv2:name "Rate" ;
        lv2:default 3 ; lv2:minimum 0 ; lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/4" ; rdf:value 0 ] , [ rdfs:label "1/8" ; rdf:value 1 ] ,
                       [ rdfs:label "1/8T" ; rdf:value 2 ] , [ rdfs:label "1/16" ; rdf:value 3 ] ,
                       [ rdfs:label "1/16T" ; rdf:value 4 ] , [ rdfs:label "1/32" ; rdf:value 5 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "gate" ; lv2:name "Gate %" ;
        lv2:default 50 ; lv2:minimum 5 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "order" ; lv2:name "Order" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Up" ; rdf:value 0 ] , [ rdfs:label "Down" ; rdf:value 1 ] ,
                       [ rdfs:label "Up-Down" ; rdf:value 2 ] , [ rdfs:label "Down-Up" ; rdf:value 3 ] ,
                       [ rdfs:label "As played" ; rdf:value 4 ] , [ rdfs:label "Random" ; rdf:value 5 ] ,
                       [ rdfs:label "Loop" ; rdf:value 6 ] ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "octaves" ; lv2:name "Octaves" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 4 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_arp> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "latch" ; lv2:name "Latch" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_play> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "transpose" ; lv2:name "Transpose" ;
        lv2:default 0 ; lv2:minimum -2 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "-2 oct" ; rdf:value -2 ] , [ rdfs:label "-1 oct" ; rdf:value -1 ] , [ rdfs:label "0" ; rdf:value 0 ] ,
                       [ rdfs:label "+1 oct" ; rdf:value 1 ] , [ rdfs:label "+2 oct" ; rdf:value 2 ] ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_pattern> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "rpt" ; lv2:name "Repeats" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 7 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] , [ rdfs:label "2" ; rdf:value 2 ] , [ rdfs:label "3" ; rdf:value 3 ] ,
                       [ rdfs:label "4" ; rdf:value 4 ] , [ rdfs:label "5" ; rdf:value 5 ] ,
                       [ rdfs:label "Rnd 3" ; rdf:value 6 ] , [ rdfs:label "Rnd 5" ; rdf:value 7 ] ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_pattern> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "rpt_mode" ; lv2:name "Rpt mode" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Same" ; rdf:value 0 ] , [ rdfs:label "Run up" ; rdf:value 1 ] ,
                       [ rdfs:label "Run down" ; rdf:value 2 ] , [ rdfs:label "Octave" ; rdf:value 3 ] ,
                       [ rdfs:label "Echo" ; rdf:value 4 ] ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_pattern> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "swing" ; lv2:name "Swing %" ;
        lv2:default 50 ; lv2:minimum 50 ; lv2:maximum 75 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_groove> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "swing_feel" ; lv2:name "Swing feel" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Pairs" ; rdf:value 0 ] , [ rdfs:label "Fours" ; rdf:value 1 ] ,
                       [ rdfs:label "Drag" ; rdf:value 2 ] , [ rdfs:label "Threes" ; rdf:value 3 ] ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_groove> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "drunk" ; lv2:name "Drunk %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_groove> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 21 ; lv2:symbol "accent" ; lv2:name "Accent %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_groove> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "len_prob" ; lv2:name "Prob len" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "len_shift" ; lv2:name "Shift len" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "len_vel" ; lv2:name "Vel len" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "len_gate" ; lv2:name "Gate len" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 24 ; lv2:symbol "len_ratch" ; lv2:name "Ratch len" ;
        lv2:default 16 ; lv2:minimum 1 ; lv2:maximum 16 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 5 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 25 ; lv2:symbol "ratch_every" ; lv2:name "Ratch every" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 8 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 4 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_lengths> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 26 ; lv2:symbol "fx" ; lv2:name "FX" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] , [ rdfs:label "Roll 1/8" ; rdf:value 1 ] ,
                       [ rdfs:label "Roll 1/16" ; rdf:value 2 ] , [ rdfs:label "Roll 1/32" ; rdf:value 3 ] ,
                       [ rdfs:label "Fill" ; rdf:value 4 ] , [ rdfs:label "Oct+" ; rdf:value 5 ] ,
                       [ rdfs:label "Half" ; rdf:value 6 ] , [ rdfs:label "Drop" ; rdf:value 7 ] ,
                       [ rdfs:label "Rev" ; rdf:value 8 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_play> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 27 ; lv2:symbol "density" ; lv2:name "Density" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_play> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 28 ; lv2:symbol "dynamics" ; lv2:name "Dynamics" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_play> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 29 ; lv2:symbol "degree" ; lv2:name "Degree" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "I" ; rdf:value 0 ] , [ rdfs:label "II" ; rdf:value 1 ] , [ rdfs:label "III" ; rdf:value 2 ] ,
                       [ rdfs:label "IV" ; rdf:value 3 ] , [ rdfs:label "V" ; rdf:value 4 ] , [ rdfs:label "VI" ; rdf:value 5 ] ,
                       [ rdfs:label "VII" ; rdf:value 6 ] ;
        lv2:displayPriority 5 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_scale> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "key" ; lv2:name "Key" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 12 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "C" ; rdf:value 0 ] , [ rdfs:label "C#" ; rdf:value 1 ] , [ rdfs:label "D" ; rdf:value 2 ] , [ rdfs:label "D#" ; rdf:value 3 ] ,
                       [ rdfs:label "E" ; rdf:value 4 ] , [ rdfs:label "F" ; rdf:value 5 ] , [ rdfs:label "F#" ; rdf:value 6 ] , [ rdfs:label "G" ; rdf:value 7 ] ,
                       [ rdfs:label "G#" ; rdf:value 8 ] , [ rdfs:label "A" ; rdf:value 9 ] , [ rdfs:label "A#" ; rdf:value 10 ] , [ rdfs:label "B" ; rdf:value 11 ] ,
                       [ rdfs:label "Auto" ; rdf:value 12 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_scale> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "scale" ; lv2:name "Scale" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 11 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Chromatic" ; rdf:value 0 ] , [ rdfs:label "Major" ; rdf:value 1 ] , [ rdfs:label "Minor" ; rdf:value 2 ] , [ rdfs:label "Dorian" ; rdf:value 3 ] ,
                       [ rdfs:label "Phrygian" ; rdf:value 4 ] , [ rdfs:label "Lydian" ; rdf:value 5 ] , [ rdfs:label "Mixolydian" ; rdf:value 6 ] , [ rdfs:label "Harm minor" ; rdf:value 7 ] ,
                       [ rdfs:label "Mel minor" ; rdf:value 8 ] , [ rdfs:label "Major pent" ; rdf:value 9 ] , [ rdfs:label "Minor pent" ; rdf:value 10 ] , [ rdfs:label "Blues" ; rdf:value 11 ] ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_scale> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 22 ; lv2:symbol "passing" ; lv2:name "Passing %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/bloom#g_scale> ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 23 ; lv2:symbol "pass_style" ; lv2:name "Pass style" ;
