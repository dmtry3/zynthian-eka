    lv2:symbol "free_hz" ;
    rdfs:label "Free Rate Hz" ;
    rdfs:range atom:Float ;
    lv2:default 4.0 ; lv2:minimum 0.25 ; lv2:maximum 32.0 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/pulse#xy_x>
    a lv2:Parameter ;
    lv2:symbol "xy_x" ;
    rdfs:label "XY Cutoff" ;
    rdfs:range atom:Float ;
    lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/pulse#xy_y>
    a lv2:Parameter ;
    lv2:symbol "xy_y" ;
    rdfs:label "XY Depth" ;
    rdfs:range atom:Float ;
    lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/pulse#xy_on>
    a lv2:Parameter ;
    lv2:symbol "xy_on" ;
    rdfs:label "XY Active" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<http://dmtry3.github.io/zynthian-eka/pulse#store_scene>
    a lv2:Parameter ;
    lv2:symbol "store_scene" ;
    rdfs:label "Store Scene" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

