    # Control input ports MUST be indices 0..N-1: Zynthian numbers LV2 parameters from len(control ports)+1.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "slot" ; lv2:name "Slot" ;
        lv2:default 4 ; lv2:minimum 1 ; lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1:Time" ; rdf:value 1 ] ,
        [ rdfs:label "2:Drive" ; rdf:value 2 ] ,
        [ rdfs:label "3:Filter" ; rdf:value 3 ] ,
        [ rdfs:label "4:Gate" ; rdf:value 4 ] ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "mix" ; lv2:name "Mix %" ;
        lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "low_split" ; lv2:name "Low Split" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 500 ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "scene" ; lv2:name "Scene" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "A" ; rdf:value 0 ] ,
        [ rdfs:label "B" ; rdf:value 1 ] ,
        [ rdfs:label "C" ; rdf:value 2 ] ,
        [ rdfs:label "D" ; rdf:value 3 ] ;
        lv2:displayPriority 10 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_main> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Mode" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 6 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Slot algorithm (Time: Curve/Chop/Stut/Stop; Drive: Tube/Fold/Hard/Crush/Combo; Filter: LP24/LP12/BP/HP/Morph/Notch/Phaser; Gate: Gate/Pan/Width/Gate+Pan)" ;
        lv2:displayPriority 40 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_fx> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "param1" ; lv2:name "Param 1" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        rdfs:comment "Slot main parameter (Time: Range; Drive: Drive %; Filter: Cutoff; Gate: Floor %)" ;
        lv2:displayPriority 30 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_fx> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "param2" ; lv2:name "Param 2" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 100 ;
        rdfs:comment "Slot secondary parameter (Time: Window; Drive: Tone/Crush; Filter: Res/FB; Gate: Width %)" ;
        lv2:displayPriority 20 ; pg:group <http://dmtry3.github.io/zynthian-eka/pulse#g_fx> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "depth" ; lv2:name "Depth %" ;
        lv2:default 100 ; lv2:minimum -100 ; lv2:maximum 100 ;
        rdfs:comment "Step Shaper curve depth (-100..+100%)" ;
