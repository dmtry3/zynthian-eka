<http://dmtry3.github.io/zynthian-eka/mist#preset_kalimba_box>
    a pset:Preset ;
    lv2:appliesTo <http://dmtry3.github.io/zynthian-eka/mist> ;
    rdfs:label "Kalimba Music Box" ;
    pset:bank <http://dmtry3.github.io/zynthian-eka/mist#bank_factory> ;
    lv2:port
        [ lv2:symbol "position" ; pset:value 0.0 ] ,
        [ lv2:symbol "scan" ; pset:value 100.0 ] ,
        [ lv2:symbol "spray" ; pset:value 0.0 ] ,
        [ lv2:symbol "window" ; pset:value 100.0 ] ,
        [ lv2:symbol "size" ; pset:value 60.0 ] ,
        [ lv2:symbol "density" ; pset:value 25.0 ] ,
        [ lv2:symbol "shape" ; pset:value 33.3 ] ,
        [ lv2:symbol "chaos" ; pset:value 0.0 ] ,
        [ lv2:symbol "pitch" ; pset:value 0.0 ] ,
        [ lv2:symbol "pitch_spray" ; pset:value 0.0 ] ,
        [ lv2:symbol "reverse" ; pset:value 0.0 ] ,
        [ lv2:symbol "quantize" ; pset:value 0.0 ] ,
        [ lv2:symbol "attack" ; pset:value 1.0 ] ,
        [ lv2:symbol "release" ; pset:value 1500.0 ] ,
        [ lv2:symbol "spread" ; pset:value 30.0 ] ,
        [ lv2:symbol "level" ; pset:value 0.8 ] ,
        [ lv2:symbol "cutoff" ; pset:value 100.0 ] ,
